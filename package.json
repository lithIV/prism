{
  "name": "prism",
  "productName": "Prism",
  "version": "1.4.4",
  "private": true,
  "description": "Prism — a personal Windows desktop agent forked from OpenGhost, with OpenCode Go, MCP, memory, subagents, Claude skills and Discord notifications",
  "main": "desktop/main.js",
  "bin": {
    "prism": "tools/prism-cli.mjs"
  },
  "scripts": {
    "start": "electron .",
    "shortcut": "electron . --create-shortcut",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --universal",
    "dist:linux": "electron-builder --linux tar.gz"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.prism.app",
    "productName": "Prism",
    "icon": "desktop/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.md",
      "!*.log",
      "!app.log"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prism",
      "artifactName": "Prism-${version}-Setup.exe",
      "uninstallDisplayName": "Prism"
    },
    "mac": {
      "target": "dmg",
      "icon": "desktop/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "Prism-${version}-mac.${ext}",
      "identity": null
    },
    "linux": {
      "target": "tar.gz",
      "icon": "desktop/icon.png",
      "category": "Utility",
      "artifactName": "Prism-${version}-linux.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ws": "^8.22.0"
  }
}
